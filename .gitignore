# All folders starting with _ are local.
_*/

# Compiled python files.
*.py[cod]

# Visual Studio files.
/.vs
**/.vscode/ipch

# macOS files.
.DS_Store

# Generated license file.
PACKAGE-DEPS.yaml

# packman .user config
*.packman.xml.user

# kit user config
deps/**/user.toml

# vscode settings are copied and filled in from 'settings.json.template'
.vscode/settings.json

# PyCharm files.
/.idea/

# Linux in docker build $HOME dirs
/.nvidia-omniverse
/.local
/.cache

# Omniverse EULA breadcrumb
/.omniverse_eula_accepted.txt

# Streaming EventTrace
*.etli

# v1d scrub (dev)
/tests/fixtures/
/docs/perf_raw/

# Local build output and machine files.
*.so
*.deb
/.cursor/
/workspace/

# Private notes kept off the public tree.
/AGENTS.md
/ARCHITECTURE.md
/PLAN_DRAG-DROP_RENDER_SAVE.md
/PLAN_PROXY.md
/PROGRESS.md
/SECURITY.md
/THIRD_PARTY.md
/TROUBLESHOOTING.md
/VERSION.md
/README.txt
/PRODUCT_TERMS_OMNIVERSE
